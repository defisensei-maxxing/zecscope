# Zcash JS 0.1.1 has no NU7 rules. Testnet activated NU7 (block 4,465,026) so it fails with NETWORK_MISMATCH.
# Mainnet works until its NU7 upgrade on 5 Nov 2026. ZecScope is watch-only, so mainnet never risks funds.
NETWORK=mainnet
LIGHTWALLETD_URL=https://zec.rocks:443
# auto = filesystem on Linux (needs flock), memory elsewhere. Or force: filesystem | memory
STORAGE=auto
DATA_DIR=./data
PORT=8787
WEB_ORIGIN=http://localhost:5173
SYNC_INTERVAL_MS=15000
